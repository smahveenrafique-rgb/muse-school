# ── school-ai-platform · environment template ──────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# App
APP_ENV=development            # development | staging | production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_API_TOKEN=change-me-to-a-long-random-token
SHA-256: 62419250892bf20dc35a0d6993b5f83404a50089d45e0b1e33f9fb6c16a783c6
# Student Master storage (SQLite file; parent dir is created on boot)
DATABASE_PATH=data/platform.db

# Upstream engines — stable API boundaries. The platform NEVER embeds
# exam/result business logic; it only calls these HTTP APIs.
# Use the "stub" scheme for local development without the engines running:
#   EXAM_API_BASE_URL=stub://exam-engine
#   RESULTS_API_BASE_URL=stub://results-engine
EXAM_API_BASE_URL=http://127.0.0.1:8100
RESULTS_API_BASE_URL=http://127.0.0.1:8200
ENGINE_API_TIMEOUT_SECONDS=30
ENGINE_API_MAX_RETRIES=2

# AI Gateway — provider chain (primary → secondary → tertiary).
# Any OpenAI-compatible provider works: OpenRouter, Groq, Gemini
# (via its OpenAI-compatible endpoint), or a self-hosted gateway.
# Leave a tier empty to shorten the chain. Keys stay server-side.
AI_PRIMARY_PROVIDER=openrouter
AI_PRIMARY_MODEL=
AI_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
AI_PRIMARY_API_KEY=
AI_SECONDARY_PROVIDER=
AI_SECONDARY_MODEL=
AI_SECONDARY_BASE_URL=
AI_SECONDARY_API_KEY=
AI_TERTIARY_PROVIDER=
AI_TERTIARY_MODEL=
AI_TERTIARY_BASE_URL=
AI_TERTIARY_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1
# Deterministic stub provider for tests / offline dev (no network, no key).
# Set AI_USE_STUB=true to force the stub for every tier.
AI_USE_STUB=false

# Uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_EXTENSIONS=xlsx,xls,pdf,png,jpg,jpeg

# Observability
LOG_LEVEL=INFO
